# ─── Banco de Dados (obrigatório) ──────────────────────────────────────────
# TiDB Cloud (MySQL compatível) — string de conexão completa.
# Em produção (Vercel) use a connection string serverless do TiDB Cloud.
DATABASE_URL="mysql://usuario:senha@host:4000/adestro?sslaccept=strict"

# ─── Autenticação NextAuth (obrigatório) ────────────────────────────────────
# AUTH_SECRET é exigido em produção. Gere com:
#   openssl rand -base64 32
AUTH_SECRET="sua-chave-secreta-de-pelo-menos-32-caracteres"
# NEXTAUTH_URL é a URL pública do app. Em produção use a URL da Vercel.
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed/Demo (opcional) ───────────────────────────────────────────────────
# Secret usado por scripts/* para popular o banco com dados de demonstração.
SEED_SECRET="sua-chave-secreta-de-seed"

# ─── Vercel Cron (recomendado em produção) ──────────────────────────────────
# Token enviado pelo Vercel Cron como Authorization: Bearer <CRON_SECRET>
# para autorizar /api/cron/daily-brief. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="hex-de-64-caracteres-gerado-aleatoriamente"

# ─── Vercel CLI (opcional, apenas para DX local) ────────────────────────────
# Token gerado em https://vercel.com/account/tokens.
# Usado para que ferramentas locais (ex: agentes de IA com permissão
# `Bash(vercel:*)`) possam inspecionar deploys sem `vercel login`.
# NUNCA exporte para produção — só no .env local do desenvolvedor.
VERCEL_TOKEN=""

# ─── Web Push (opcional — habilita notificações push) ───────────────────────
# Gere os pares VAPID uma única vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Cole o publicKey e o privateKey aqui (ambos em base64-url).
# Sem essas chaves, o card "Ativar notificações push" mostra aviso e
# o cron daily-brief ignora envio (zero erro, só sem notificação push).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@dominio.com"

# ─── Assistente de IA (opcional — liga a IA REAL no chat) ───────────────────
# Sem essa chave, o chat usa o motor heurístico (respostas por palavra-chave).
# Com a chave, o chat usa o Gemini com contexto do cão + memória da conversa.
# Pegue uma chave GRATUITA em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Modelo (opcional). Padrão: gemini-2.0-flash (rápido e no tier gratuito).
GEMINI_MODEL="gemini-2.0-flash"
